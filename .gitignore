# Python
__pycache__/
*.py[cod]
.venv/
build/
dist/
*.egg-info/

# Tooling caches
.pytest_cache/
.ruff_cache/
.pyright/
.coverage
htmlcov/

# Local config and secrets: API keys live in Windows Credential Manager, never in files
# (anchored to the repo root, so it can't hide source files like a secrets.py module)
.env
.env.*
*.local.toml
/secrets.*
*.secret.*

# Recorded audio, captures and benchmark output stay local, unless a file is added to
# tests/fixtures on purpose
recordings/
captures/
*.wav
*.mp3
*.ogg
*.flac
*.jsonl
!tests/fixtures/**

# Editors and OS
.vscode/
.idea/
Thumbs.db
.DS_Store
