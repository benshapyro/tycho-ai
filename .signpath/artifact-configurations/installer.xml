<?xml version="1.0" encoding="utf-8"?>
<!-- The installer, built from the signed programs (#9, docs/code-signing.md). Paste into
     the SignPath project's artifact configuration with the slug "installer". The file
     is named by the version parameter, as SignPath's syntax allows in any attribute (#724). -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="TychoSetup-${version}.exe" product-name="Tycho" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
