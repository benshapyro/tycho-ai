<?xml version="1.0" encoding="utf-8"?>
<!-- Tycho's own two programs, signed before the installer is built (#9,
     docs/code-signing.md). Paste into the SignPath project's artifact configuration
     with the slug "exes". Third-party DLLs ship unsigned: SignPath Foundation signs a
     project's own binaries only. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file-set product-name="Tycho" product-version="${version}">
      <include path="tycho.exe" />
      <include path="tycho-app.exe" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
